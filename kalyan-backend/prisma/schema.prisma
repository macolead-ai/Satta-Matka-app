generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String            @id @default(cuid())
  phone       String            @unique
  name        String
  password    String
  balance     Int               @default(0) // rupees
  createdAt   DateTime          @default(now())
  bids        Bid[]
  txns        Transaction[]
  withdrawals WithdrawRequest[]
  deposits    DepositRequest[]
}

model DepositRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  method    String   @default("UPI") // UPI | Bank
  reference String // UTR / transaction id / sender detail
  proof     String? // base64 data URL of the payment screenshot
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}

// Singleton (id = "payment") holding the platform's deposit details
model Setting {
  id          String   @id
  upiId       String?
  upiName     String?
  bankDetails String?
  qrImage     String? // base64 data URL of the payment QR
  updatedAt   DateTime @updatedAt
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  totpSecret  String? // base32 secret for Google Authenticator
  totpEnabled Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Market {
  id        String   @id @default(cuid())
  name      String
  openTime  String // "07:00 PM"
  closeTime String // "08:00 PM"
  status    String   @default("open") // open | closed
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  bids      Bid[]
  results   Result[]
}

model Bid {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  gameType   String // "Single Digit" | "Jodi Digits" | "Single Panna" ...
  selections Json // { "05": 100, "23": 50 }
  total      Int
  status     String   @default("pending") // pending | won | lost
  createdAt  DateTime @default(now())
}

model Result {
  id         String   @id @default(cuid())
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  value      String // "128-14-590"
  declaredAt DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // deposit | withdraw | bid | win
  amount    Int // signed: +deposit/win, -bid/withdraw
  note      String?
  createdAt DateTime @default(now())
}

model WithdrawRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}
